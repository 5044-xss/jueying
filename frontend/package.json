{
  "name": "jueying-desktop",
  "productName": "掘影",
  "private": true,
  "version": "0.1.0",
  "description": "掘影 视频生成工作台（Electron + React）",
  "author": "掘影",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron electron/main.cjs",
    "dev:electron": "concurrently -k -n vite,electron -c cyan,magenta \"npm:dev\" \"npm:electron\"",
    "build": "tsc -b && vite build",
    "build:backend": "node scripts/build-backend.mjs",
    "package": "npm run build:backend && npm run build && electron-builder",
    "package:dir": "npm run build:backend && npm run build && electron-builder --dir",
    "release": "node scripts/release.mjs",
    "preview": "vite preview",
    "lint": "oxlint",
    "gen-keypair": "node scripts/gen-keypair.mjs",
    "sign-license": "node scripts/sign-license.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.54.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.89.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.jueying.app",
    "productName": "掘影",
    "icon": "public/app-icon.png",
    "directories": {
      "output": "release"
    },
    "files": ["dist/**", "electron/**", "package.json"],
    "extraResources": [
      { "from": "resources/backend", "to": "backend" }
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "public/app-icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
