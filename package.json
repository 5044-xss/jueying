{
  "name": "jueying",
  "private": true,
  "version": "0.1.5",
  "description": "掘影 · 视频生成工作台",
  "author": "掘影",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron electron/main.cjs",
    "dev:electron": "concurrently -k -n vite,electron -c cyan,magenta \"npm:dev\" \"npm:electron\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit",
    "icon": "node scripts/gen-icon.mjs && node scripts/gen-mobile-icons.mjs",
    "icon:mobile": "node scripts/gen-mobile-icons.mjs",
    "pack:pc": "node scripts/gen-icon.mjs && npm run build && electron-builder",
    "pack:win": "node scripts/gen-icon.mjs && npm run build && electron-builder --win",
    "pack:mac": "node scripts/gen-icon.mjs && npm run build && electron-builder --mac",
    "pack:linux": "node scripts/gen-icon.mjs && npm run build && electron-builder --linux",
    "cap:sync": "node scripts/gen-mobile-icons.mjs && npm run build && cap sync",
    "android": "node scripts/gen-mobile-icons.mjs && npm run build && cap sync android && cap open android",
    "ios": "node scripts/gen-mobile-icons.mjs && npm run build && cap sync ios && cap open ios",
    "android:apk": "node scripts/build-android.mjs"
  },
  "build": {
    "appId": "com.jueying.app",
    "productName": "掘影",
    "copyright": "Copyright © 2026 掘影",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "jueying"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-windows.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "掘影"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.video"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.6.0",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/share": "^8.0.3",
    "@noble/ed25519": "^2.3.0",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^0.544.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.81.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.29",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.5.1"
  }
}
